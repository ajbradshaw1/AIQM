# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Session data and run artifacts (per-session output, never in git)
logs/

# OCR debug crops (set by AIQM_OCR_DEBUG=1, scoped under logs/ but explicit)
logs/ocr_debug/

# Test runner cache
.pytest_cache/
.codex-jobs/

# Reproducible local validation previews
tmp/

# Local-only build outputs
*.egg-info/
dist/
build/

# Model weights — 203 MB, distributed outside Git and fetched on demand.
# models/WEIGHTS_MANIFEST.json records every sha256; see
# scripts/fetch_model_weights.py. Committing these once put 83 MB on every
# clone forever, and Git history is append-only.
models/**/*.pth
